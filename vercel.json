{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.png"
    }
  ],
  "redirects": [
    {
      "source": "/h1/:path*",
      "destination": "/h1-cc/",
      "statusCode": 301
    },
    {
      "source": "/d-heights/:path*",
      "destination": "/d-heights-cc/",
      "statusCode": 301
    },
    {
      "source": "/jaeil/:path*",
      "destination": "/jaeil-cc/",
      "statusCode": 301
    }
  ]
}